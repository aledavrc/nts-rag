# Entrada: chunks generados por pipelines/ocr/md_to_vector.py
NTS_RAG_CHUNKS_PATH=data/chunks/nts-246.chunks.jsonl

# Rutas
NTS_RAG_DATA_DIR=data
NTS_RAG_MODELS_DIR=models

# Embeddings (FastEmbed / ONNX)
NTS_RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Base vectorial
NTS_RAG_CHROMA_COLLECTION=nts_246

# Recuperación
NTS_RAG_TOP_K=6
NTS_RAG_VECTOR_K=12
NTS_RAG_BM25_K=12

# LLM compatible con OpenAI (Ollama, OpenAI, etc.)
# Si se deja vacío, la API responde en modo extractivo con citas.
NTS_RAG_LLM_BASE_URL=
NTS_RAG_LLM_MODEL=qwen2.5:7b
NTS_RAG_LLM_API_KEY=ollama
NTS_RAG_LLM_TIMEOUT=60

# Con LLM configurado, re-ordena los candidatos y verifica la fidelidad de la
# respuesta frente a las fuentes. Poner en false para omitir cada paso.
NTS_RAG_RERANK=true
NTS_RAG_VERIFY=true
